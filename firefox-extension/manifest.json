{
  "manifest_version": 2,
  "name": "Runespeak Lite — Read Selection",
  "version": "0.2.0",
  "description": "Send selected text to the already-open local Runespeak app.",
  "browser_specific_settings": {"gecko": {"id": "runespeak-lite@local", "strict_min_version": "91.0"}},
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "notifications"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Runespeak Lite", "default_popup": "popup.html", "default_icon": "icon.svg"},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "commands": {"read-selection": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read selected text in Runespeak Lite"}}
}
